<!-- ENDING -->
<section class="ending" id="ending">
  <canvas id="fireworks-canvas"></canvas>
  <div class="ending-inner">
    <h2 class="reveal glow-text">Happy Girlfriend Day, Alex ❤️</h2>
    <p class="reveal">You are my peace, my happiness, my safe place, and the future I pray for every single day. I love you more than words can ever explain.</p>
    <div class="letter-sign reveal">Forever Yours, Ahmed ❤️</div>
  </div>
</section>

<footer>🫶🏻 Alexy Meri Hai 🫂</footer>

<script>
/* ============ LOADER ============ */
window.addEventListener('load', () => {
  setTimeout(() => document.getElementById('loader').classList.add('hide'), 1400);
});

/* ============ REVEAL ON SCROLL ============ */
const revealEls = document.querySelectorAll('.reveal');
const io = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
}, {threshold:0.15});
revealEls.forEach(el => io.observe(el));

/* ============ HERO ROTATOR ============ */
const words = ["My Peace","My Happiness","My Safe Place","My Future Wife","My Everything"];
let wi = 0;
const rotEl = document.getElementById('rotator-word');
setInterval(() => {
  rotEl.style.opacity = 0; rotEl.style.transform = 'translateY(8px)';
  setTimeout(() => {
    wi = (wi+1) % words.length;
    rotEl.textContent = words[wi];
    rotEl.style.opacity = 1; rotEl.style.transform = 'translateY(0)';
  }, 400);
}, 2600);

document.getElementById('beginBtn').addEventListener('click', () => {
  document.getElementById('letter').scrollIntoView({behavior:'smooth'});
});

/* ============ STARS ============ */
const starsCanvas = document.getElementById('stars-canvas');
const sctx = starsCanvas.getContext('2d');
let stars = [];
function sizeCanvas(c){ c.width = window.innerWidth; c.height = document.body.scrollHeight; }
function initStars(){
  sizeCanvas(starsCanvas);
  stars = [];
  const count = Math.floor((starsCanvas.width * window.innerHeight) / 9000);
  for(let i=0;i<count;i++){
    stars.push({
      x: Math.random()*starsCanvas.width,
      y: Math.random()*starsCanvas.height,
      r: Math.random()*1.3 + 0.2,
      a: Math.random(),
      speed: Math.random()*0.015 + 0.003
    });
  }
}
function drawStars(){
  sctx.clearRect(0,0,starsCanvas.width, starsCanvas.height);
  stars.forEach(s => {
    s.a += s.speed;
    const alpha = (Math.sin(s.a)+1)/2 * 0.8 + 0.1;
    sctx.beginPath();
    sctx.fillStyle = `rgba(255,255,255,${alpha})`;
    sctx.arc(s.x, s.y, s.r, 0, Math.PI*2);
    sctx.fill();
  });
  requestAnimationFrame(drawStars);
}
initStars(); drawStars();

/* ============ GLOWING PARTICLES + FLOATING HEARTS ============ */
const pCanvas = document.getElementById('particles-canvas');
const pctx = pCanvas.getContext('2d');
let particles = [];
function initParticles(){
  pCanvas.width = window.innerWidth;
  pCanvas.height = window.innerHeight;
  particles = [];
  const count = window.innerWidth < 700 ? 16 : 30;
  for(let i=0;i<count;i++){
    particles.push({
      x: Math.random()*pCanvas.width,
      y: Math.random()*pCanvas.height,
      r: Math.random()*2 + 0.6,
      speedY: Math.random()*0.35 + 0.1,
      drift: Math.random()*0.4 - 0.2,
      alpha: Math.random()*0.5 + 0.2
    });
  }
}
function drawParticles(){
  pctx.clearRect(0,0,pCanvas.width, pCanvas.height);
  particles.forEach(p => {
    p.y -= p.speedY; p.x += p.drift;
    if(p.y < -10){ p.y = pCanvas.height + 10; p.x = Math.random()*pCanvas.width; }
    pctx.beginPath();
    const grad = pctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*4);
    grad.addColorStop(0, `rgba(255,214,232,${p.alpha})`);
    grad.addColorStop(1, 'rgba(255,214,232,0)');
    pctx.fillStyle = grad;
    pctx.arc(p.x,p.y,p.r*4,0,Math.PI*2);
    pctx.fill();
  });
  requestAnimationFrame(drawParticles);
}
initParticles(); drawParticles();

/* ============ FALLING WHITE ROSES ============ */
const rCanvas = document.getElementById('roses-canvas');
const rctx = rCanvas.getContext('2d');
let roses = [];
function initRoses(){
  rCanvas.width = window.innerWidth;
  rCanvas.height = window.innerHeight;
  roses = [];
  const count = window.innerWidth < 700 ? 6 : 12;
  for(let i=0;i<count;i++){
    roses.push({
      x: Math.random()*rCanvas.width,
      y: Math.random()*-rCanvas.height,
      size: Math.random()*10 + 8,
      speed: Math.random()*0.5 + 0.3,
      sway: Math.random()*2,
      swaySpeed: Math.random()*0.02 + 0.005,
      rot: Math.random()*360
    });
  }
}
function drawRose(x,y,size,rot){
  rctx.save();
  rctx.translate(x,y);
  rctx.rotate(rot * Math.PI/180);
  rctx.fillStyle = 'rgba(250,246,243,0.75)';
  for(let i=0;i<5;i++){
    rctx.beginPath();
    rctx.ellipse(0, -size*0.35, size*0.32, size*0.5, (i*72)*Math.PI/180, 0, Math.PI*2);
    rctx.fill();
  }
  rctx.restore();
}
function drawRoses(){
  rctx.clearRect(0,0,rCanvas.width, rCanvas.height);
  roses.forEach(r => {
    r.y += r.speed;
    r.x += Math.sin(r.y*r.swaySpeed) * r.sway * 0.05;
    r.rot += 0.3;
    if(r.y > rCanvas.height + 20){ r.y = -20; r.x = Math.random()*rCanvas.width; }
    drawRose(r.x, r.y, r.size, r.rot);
  });
  requestAnimationFrame(drawRoses);
}
initRoses(); drawRoses();

window.addEventListener('resize', () => {
  initStars(); initParticles(); initRoses();
});

/* ============ LIVE LOVE COUNTER ============ */
const startDate = new Date(new Date().getFullYear(), 0, 27);
if(new Date() < startDate){ startDate.setFullYear(startDate.getFullYear()-1); }
// Use the most recent Jan 27 anniversary date, but total elapsed should be since the very first Jan 27 two years ago.
const originStart = (() => {
  const now = new Date();
  let year = now.getFullYear();
  const jan27ThisYear = new Date(year,0,27);
  // relationship began 2 years ago on Jan 27
  const anniversaryYear = jan27ThisYear <= now ? year - 2 : year - 3;
  return new Date(anniversaryYear, 0, 27, 0, 0, 0);
})();
function updateCounter(){
  const now = new Date();
  let diff = Math.max(0, now - originStart);
  const days = Math.floor(diff / 86400000);
  const hours = Math.floor((diff % 86400000)/3600000);
  const mins = Math.floor((diff % 3600000)/60000);
  const secs = Math.floor((diff % 60000)/1000);
  document.getElementById('c-days').textContent = days.toLocaleString();
  document.getElementById('c-hours').textContent = String(hours).padStart(2,'0');
  document.getElementById('c-mins').textContent = String(mins).padStart(2,'0');
  document.getElementById('c-secs').textContent = String(secs).padStart(2,'0');
}
updateCounter(); setInterval(updateCounter, 1000);

/* ============ QUIZ ============ */
const quizData = [
  { q:"What day did our story begin?", opts:["14 February","27 January","1 January","8 March"], a:1 },
  { q:"What do I call her?", opts:["Alex","Alexy","Lexi","Ally"], a:1 },
  { q:"What is her favorite food?", opts:["Biryani","Mutton Karahi","Pizza","Nihari"], a:1 },
  { q:"What does she dream of becoming?", opts:["A doctor","A teacher","An engineer","A pilot"], a:0 },
  { q:"What is our favorite movie?", opts:["Saiyaara","Kabir Singh","Tum Hi Aana","Aashiqui 2"], a:0 }
];
let qi = 0, answered = false;
const quizQ = document.getElementById('quizQ');
const quizOpts = document.getElementById('quizOpts');
const quizProgress = document.getElementById('quizProgress');
const quizActive = document.getElementById('quizActive');
const quizResult = document.getElementById('quizResult');

function renderProgress(){
  quizProgress.innerHTML = '';
  quizData.forEach((_,i) => {
    const dot = document.createElement('span');
    if(i < qi) dot.classList.add('done');
    quizProgress.appendChild(dot);
  });
}
function renderQuestion(){
  answered = false;
  const item = quizData[qi];
  quizQ.textContent = item.q;
  quizOpts.innerHTML = '';
  item.opts.forEach((opt, idx) => {
    const btn = document.createElement('div');
    btn.className = 'quiz-opt';
    btn.textContent = opt;
    btn.addEventListener('click', () => {
      if(answered) return;
      answered = true;
      if(idx === item.a){ btn.classList.add('correct'); }
      else { btn.classList.add('wrong'); [...quizOpts.children][item.a].classList.add('correct'); }
      setTimeout(() => {
        qi++;
        if(qi < quizData.length){ renderProgress(); renderQuestion(); }
        else {
          renderProgress();
          quizActive.style.display = 'none';
          quizResult.classList.add('show');
        }
      }, 850);
    });
    quizOpts.appendChild(btn);
  });
  renderProgress();
}
renderQuestion();

/* ============ SURPRISE ============ */
document.getElementById('surpriseBtn').addEventListener('click', () => {
  document.getElementById('surpriseMsg').classList.add('show');
});

/* ============ SECRET HEART ============ */
const secretHeart = document.getElementById('secretHeart');
const secretModal = document.getElementById('secretModal');
secretHeart.addEventListener('click', () => secretModal.classList.add('show'));
document.getElementById('secretClose').addEventListener('click', () => secretModal.classList.remove('show'));

/* ============ FIREWORKS (ending) ============ */
const fwCanvas = document.getElementById('fireworks-canvas');
const fctx = fwCanvas.getContext('2d');
let fwParticles = [];
function resizeFw(){
  fwCanvas.width = fwCanvas.offsetWidth;
  fwCanvas.height = fwCanvas.offsetHeight;
}
function spawnFirework(){
  const x = Math.random()*fwCanvas.width;
  const y = Math.random()*fwCanvas.height*0.6 + 20;
  const colors = ['#f0b8cc','#ffd6e8','#faf6f3','#e8a8b8'];
  const color = colors[Math.floor(Math.random()*colors.length)];
  const count = 26;
  for(let i=0;i<count;i++){
    const angle = (Math.PI*2/count)*i;
    const speed = Math.random()*2 + 1.2;
    fwParticles.push({
      x,y, vx: Math.cos(angle)*speed, vy: Math.sin(angle)*speed,
      life: 1, color
    });
  }
}
function drawFireworks(){
  fctx.clearRect(0,0,fwCanvas.width, fwCanvas.height);
  fwParticles.forEach(p => {
    p.x += p.vx; p.y += p.vy; p.vy += 0.02; p.life -= 0.012;
    fctx.globalAlpha = Math.max(p.life,0);
    fctx.fillStyle = p.color;
    fctx.beginPath(); fctx.arc(p.x,p.y,1.8,0,Math.PI*2); fctx.fill();
  });
  fctx.globalAlpha = 1;
  fwParticles = fwParticles.filter(p => p.life > 0);
  requestAnimationFrame(drawFireworks);
}
let fwStarted = false;
const fwObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if(e.isIntersecting && !fwStarted){
      fwStarted = true;
      resizeFw();
      drawFireworks();
      spawnFirework();
      setInterval(() => { if(Math.random() > 0.35) spawnFirework(); }, 900);
    }
  });
}, {threshold:0.3});
fwObserver.observe(document.getElementById('ending'));
window.addEventListener('resize', resizeFw);
</script>
